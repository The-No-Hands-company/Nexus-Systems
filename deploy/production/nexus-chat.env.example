# nexus-chat (apps/Nexus) — runtime settings for this node.
#
# Copy to deploy/production/nexus-chat.env and fill in the secrets, which are
# the ones the ecosystem's own containers already use:
#   NEXUS__DATABASE__URL  -> nexus-systems-postgres-1, database `nexus_chat`
#   NEXUS__REDIS__URL     -> nexus-systems-redis-1
#   NEXUS__STORAGE__*     -> nexus-systems-minio-1 (MINIO_ROOT_USER / _PASSWORD)
#
# Ports are 818x, not nexus-chat's 808x defaults: 8080 is the ecosystem proxy
# and 8090 is the Hosting site-proxy. See deploy/production/nexus-chat.Caddyfile,
# which fronts these three ports as one origin for chat.tnhc.dev.

NEXUS__SERVER__HOST=127.0.0.1
NEXUS__SERVER__NAME=chat.tnhc.dev

NEXUS__DATABASE__URL=postgres://nexus:<postgres-password>@127.0.0.1:5432/nexus_chat
NEXUS__REDIS__URL=redis://127.0.0.1:6379

NEXUS__STORAGE__ENDPOINT=http://127.0.0.1:9000
NEXUS__STORAGE__ACCESS_KEY=<minio-root-user>
NEXUS__STORAGE__SECRET_KEY=<minio-root-password>
NEXUS__STORAGE__BUCKET=nexus-chat-uploads
NEXUS__STORAGE__REGION=us-east-1

# Public origin the SPA and federation advertise. Cloudflare terminates TLS.
PUBLIC_URL=https://chat.tnhc.dev
