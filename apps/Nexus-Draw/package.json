{
  "name": "nexus-draw",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Nexus ecosystem app",
  "scripts": {
    "dev": "bun run src/index.ts",
    "start": "bun run src/index.ts",
    "precheck": "test -x node_modules/.bin/tsc && test -e node_modules/bun-types/package.json || npm install --workspaces=false --include=dev --ignore-scripts --no-audit --no-fund --package-lock=false",
    "check": "bunx tsc --noEmit",
    "test": "bun test tests/",
    "lint": "bunx biome check src tests",
    "format": "bunx biome check --write src tests"
  },
  "dependencies": {
    "lib0": "^0.2.117",
    "y-protocols": "^1.0.7",
    "yjs": "^13.6.23"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "bun-types": "^1.3.11",
    "typescript": "^5.8.3"
  }
}
