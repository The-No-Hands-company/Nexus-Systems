{
  "name": "nexus-forge",
  "version": "0.1.0",
  "description": "Self-hosted git forge: smart HTTP, signed-push policy, hash-chained ref log",
  "type": "module",
  "main": "dist/backend/main.js",
  "scripts": {
    "dev": "bun run src/backend/main.ts",
    "build": "bun build src/backend/main.ts --target bun --outdir dist/backend",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "lint": "biome check src tests",
    "format": "biome check --write src tests",
    "typecheck": "tsc --noEmit",
    "check": "bun run typecheck && bun run lint",
    "forge": "bun src/cli/forge.ts"
  },
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.20.0"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/node": "^20.10.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@biomejs/biome": "^1.9.4",
    "typescript": "^5.3.0",
    "vite": "^5.4.0",
    "@vitejs/plugin-react": "^4.2.0"
  },
  "engines": {
    "bun": ">=1.0.0",
    "node": ">=22.0.0"
  }
}
