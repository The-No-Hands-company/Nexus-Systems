{
  "name": "nexus-dashboard",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Nexus ecosystem app",
  "scripts": {
    "dev": "bun run src/index.ts",
    "start": "bun run src/index.ts",
    "precheck": "if [ ! -x node_modules/.bin/tsc ] || [ ! -e node_modules/bun-types/package.json ]; then bun install --ignore-scripts; fi",
    "check": "tsc --noEmit",
    "test": "bun test tests/",
    "lint": "bunx biome check src tests",
    "format": "bunx biome check --write src tests"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "bun-types": "^1.3.11",
    "typescript": "^5.8.3"
  }
}
