{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022"],
    "outDir": "dist",
    "rootDir": "src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "types": ["node"],
  "typeRoots": ["./types", "./node_modules/@types"]
  },
  "include": ["src"],
  "references": [
    {
      "path": "../Nexus-Hosting/lib/db"
    },
    {
      "path": "../Nexus-Hosting/lib/api-zod"
    }
  ]
}
