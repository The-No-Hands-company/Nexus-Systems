# Public monorepo scope
*
!/.gitignore
!/.gitmodules
!/.githooks/
!/.githooks/**
!/.secrets.baseline
!/README.md
!/docker-compose.yml
!/apps/
!/apps/**
!/docs/
!/docs/**
!/.github/
!/.github/**
!/deploy/
!/deploy/**
!/ghost/
!/ghost/**
!/packages/
!/packages/**
!/tools/
!/tools/**
!/scripts/
!/scripts/**
!/dhts/
!/dhts/**

# Local-only paths explicitly excluded from public repo
Nexus-Systems.code-workspace
Nexus_Systems_Ecosystem_Blueprint.md
VersaAI-LegecyOnly/
Backups/

# Secret and local artifact safety (inside allowed folders too)
**/.env
**/.env.*
**/*.pem
**/*.key
**/*.crt
**/*.p12
**/*.pfx
**/*.secret
**/secrets/

# Nexus-Auth's user store — password hashes, and this repo is public. Accounts
# are runtime state, not source: a fresh deploy seeds founder/operator from
# NEXUS_AUTH_FOUNDER_PASSWORD / _OPERATOR_PASSWORD in apps/Nexus-Auth/.env.
apps/Nexus-Auth/data/auth-users.json

**/__pycache__/
**/*.py[cod]
**/*.so
**/.venv/
**/venv/
**/.pytest_cache/
**/.mypy_cache/
**/.ruff_cache/
**/node_modules/
**/.npm/
**/.pnpm-store/
**/.yarn/
**/target/
**/dist/
**/build/
**/build2/
**/build_old/
**/coverage/
**/.cache/
**/test-results/
**/.DS_Store
**/Thumbs.db

# Editor/agent scratch and backup files
*.bak
**/.claude/scheduled_tasks.lock
