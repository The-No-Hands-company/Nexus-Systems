# Public monorepo scope
*
!/.gitignore
!/.gitmodules
!/.githooks/
!/.githooks/**
!/.secrets.baseline
!/README.md
!/docker-compose.yml
!/apps/
!/apps/**
!/docs/
!/docs/**
!/.github/
!/.github/**
!/deploy/
!/deploy/**
!/ghost/
!/ghost/**
!/packages/
!/packages/**
!/tools/
!/tools/**
!/scripts/
!/scripts/**
!/dhts/
!/dhts/**

# Every app reaches its database through a symlink chain that ends here:
# apps/<App>/data -> ../data -> ../data == this directory. The symlinks are
# tracked but the target was not, so a fresh checkout materialised the chain
# with nothing at the end of it and every `new Database("data/…")` failed with
# SQLITE_CANTOPEN — which is why all seven bun-apps CI jobs failed while passing
# locally, where this directory happens to exist.
#
# The directory is whitelisted, its contents are not: these are app databases and
# runtime state, which do not belong in a public repo.
!/data/
/data/*
!/data/.gitkeep

# Local-only paths explicitly excluded from public repo
Nexus-Systems.code-workspace
Nexus_Systems_Ecosystem_Blueprint.md
VersaAI-LegecyOnly/
Backups/

# Secret and local artifact safety (inside allowed folders too)
**/.env
**/.env.*
**/*.pem
**/*.key
**/*.crt
**/*.p12
**/*.pfx
**/*.secret
**/secrets/

# Nexus-Auth's user store — password hashes, and this repo is public. Accounts
# are runtime state, not source: a fresh deploy seeds founder/operator from
# NEXUS_AUTH_FOUNDER_PASSWORD / _OPERATOR_PASSWORD in apps/Nexus-Auth/.env.
apps/Nexus-Auth/data/auth-users.json

# Registered OIDC clients — holds client secrets, and this repo is public.
# Runtime state: a deploy registers its own clients.
apps/Nexus-Auth/data/oidc-clients.json

# Runtime state that regenerates, and churns the tree on every request.
# Guardian's policy, six rules, rate limits and alerts are all seeded from
# src/rules.ts, src/rate-limiter.ts and src/alerts.ts — the persisted policy is
# byte-identical to defaultPolicy in src/state.ts, so nothing configured is lost.
# Tunnel's file is routes and reachability only: no certificates, no key material.
apps/Nexus-Guardian/data/guardian-state.json
apps/Nexus-Tunnel/data/tunnel-state.json

**/__pycache__/
**/*.py[cod]
**/*.so
**/.venv/
**/venv/
